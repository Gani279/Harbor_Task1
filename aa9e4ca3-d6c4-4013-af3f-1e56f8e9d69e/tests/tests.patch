+	/**
+	 * The creation flow (shared by cfnUpdate and cfnCreateChangeSet) must
+	 * reject an unsupported parameter-file extension before any AWS request
+	 * is made. This is exercised through cfnUpdate's own pre-existing
+	 * {@code Execution} class -- not the new step classes -- since the
+	 * validation is shared and cfnUpdate's Execution/step/workspace fields
+	 * predate this change.
+	 */
+	@Test
+	public void parameterFileValidationRejectsUnsupportedExtensionBeforeAnyAwsCall() throws Exception {
+		CFNUpdateStep step = new CFNUpdateStep("my-stack");
+		step.setParamsFile("params.txt");
+
+		CFNUpdateStep.Execution execution = new CFNUpdateStep.Execution();
+		setPrivateField(execution, "step", step);
+
+		try {
+			execution.start();
+			Assert.fail("an unsupported parameter-file extension must fail before any AWS call is attempted");
+		} catch (RuntimeException expected) {
+			// expected: no Thread starting AWS work is reached for an invalid extension
+		}
+	}
+
+	@Test
+	public void parameterFileValidationAcceptsJsonAndYamlExtensionsWithoutThrowing() throws Exception {
+		FilePath testResources = new FilePath(new File("src/test/resources"));
+
+		CFNUpdateStep jsonStep = new CFNUpdateStep("my-stack");
+		jsonStep.setParamsFile("params.json");
+		jsonStep.setCreate(false);
+		CFNUpdateStep.Execution jsonExecution = new CFNUpdateStep.Execution();
+		setPrivateField(jsonExecution, "step", jsonStep);
+		setPrivateField(jsonExecution, "workspace", testResources);
+		Assert.assertFalse("a supported parameter-file extension must not fail synchronously",
+				jsonExecution.start());
+
+		CFNUpdateStep yamlStep = new CFNUpdateStep("my-stack");
+		yamlStep.setParamsFile("params.yaml");
+		yamlStep.setCreate(false);
+		CFNUpdateStep.Execution yamlExecution = new CFNUpdateStep.Execution();
+		setPrivateField(yamlExecution, "step", yamlStep);
+		setPrivateField(yamlExecution, "workspace", testResources);
+		Assert.assertFalse("a supported parameter-file extension must not fail synchronously",
+				 yamlExecution.start());
+	}

+	@Test
+	public void createChangeSetStepDefaultsAndSetters() {
+		CFNCreateChangeSetStep step = new CFNCreateChangeSetStep("cs", "stack");
+
+		Assert.assertEquals(Long.valueOf(1000L), step.getPollInterval());
+		Assert.assertEquals(Boolean.TRUE, step.getCreate());
+		Assert.assertNull(step.getFile());
+		Assert.assertNull(step.getUrl());
+		Assert.assertNull(step.getRoleArn());
+
+		step.setFile("template.yaml");
+		step.setUrl("https://s3.amazonaws.com/bucket/template.yaml");
+		step.setParams(new String[]{"InstanceType=t2.nano"});
+		step.setKeepParams(new String[]{"Version"});
+		step.setTags(new String[]{"TagName=Value"});
+		step.setParamsFile("params.json");
+		step.setPollInterval(2000L);
+		step.setCreate(false);
+		step.setRoleArn("arn:aws:iam::123456789012:role/S3Access");
+
+		Assert.assertEquals("template.yaml", step.getFile());
+		Assert.assertEquals("https://s3.amazonaws.com/bucket/template.yaml", step.getUrl());
+		Assert.assertArrayEquals(new String[]{"InstanceType=t2.nano"}, step.getParams());
+		Assert.assertArrayEquals(new String[]{"Version"}, step.getKeepParams());
+		Assert.assertArrayEquals(new String[]{"TagName=Value"}, step.getTags());
+		Assert.assertEquals("params.json", step.getParamsFile());
+		Assert.assertEquals(Long.valueOf(2000L), step.getPollInterval());
+		Assert.assertEquals(Boolean.FALSE, step.getCreate());
+		Assert.assertEquals("arn:aws:iam::123456789012:role/S3Access", step.getRoleArn());
+	}

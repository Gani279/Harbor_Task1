+	/**
+	 * Minimal stand-in for the AWS client that records the calls made by
+	 * {@link CloudFormationStack} without touching the network. Stubbed
+	 * responses report a terminal status so that the AWS SDK waiters used by
+	 * {@link CloudFormationStack} resolve immediately and deterministically
+	 * instead of polling.
+	 */
+	private static class RecordingCfnClient extends AmazonCloudFormationClient {
+
+		private final boolean hasChanges;
+		boolean stackExists;
+		int describeCalls = 0;
+		int deleteCalls = 0;
+		int executeCalls = 0;
+		int createCalls = 0;
+		int describeStackEventsCalls = 0;
+		CreateChangeSetRequest lastCreateChangeSetRequest;
+
+		RecordingCfnClient(boolean hasChanges) {
+			this.hasChanges = hasChanges;
+		}
+
+		@Override
+		public DescribeStacksResult describeStacks(DescribeStacksRequest request) {
+			if (!this.stackExists) {
+				throw new AmazonCloudFormationException("Stack does not exist");
+			}
+
+			Stack stack = new Stack()
+					.withStackStatus("UPDATE_COMPLETE")
+					.withOutputs(new Output()
+							.withOutputKey("key")
+							.withOutputValue("value"));
+
+			return new DescribeStacksResult().withStacks(stack);
+		}
+
+		@Override
+		public DescribeStackEventsResult describeStackEvents(DescribeStackEventsRequest request) {
+			this.describeStackEventsCalls++;
+			return new DescribeStackEventsResult().withStackEvents(new ArrayList<StackEvent>());
+		}
+
+		@Override
+		public DescribeChangeSetResult describeChangeSet(DescribeChangeSetRequest request) {
+			this.describeCalls++;
+			DescribeChangeSetResult result = new DescribeChangeSetResult().withStatus("CREATE_COMPLETE").withChangeSetType(ChangeSetType.UPDATE.toString());
+			if (this.hasChanges) {
+				result.withChanges(new Change());
+			} else {
+				result.withChanges(new ArrayList<Change>());
+			}
+			return result;
+		}
+
+		@Override
+		public DeleteChangeSetResult deleteChangeSet(DeleteChangeSetRequest request) {
+			this.deleteCalls++;
+			return new DeleteChangeSetResult();
+		}
+
+		@Override
+		public ExecuteChangeSetResult executeChangeSet(ExecuteChangeSetRequest request) {
+			this.executeCalls++;
+			return new ExecuteChangeSetResult();
+		}
+
+		@Override
+		public CreateChangeSetResult createChangeSet(CreateChangeSetRequest request) {
+			this.createCalls++;
+			this.lastCreateChangeSetRequest = request;
+			return new CreateChangeSetResult();
+		}
+	}

+	/**
+	 * cfnUpdate predates this change set support and is refactored to share
+	 * its defaults/validation with the new steps via {@code AbstractCFNCreateStep}.
+	 * This guards that the refactor did not change cfnUpdate's own
+	 * already-public contract (poll interval, create, roleArn).
+	 */
+	@Test
+	public void cfnUpdateStepKeepsItsPublicDefaultsAfterSharingTheAbstractBase() {
+		CFNUpdateStep step = new CFNUpdateStep("my-stack");
+
+		Assert.assertEquals(Long.valueOf(1000L), step.getPollInterval());
+		Assert.assertEquals(Boolean.TRUE, step.getCreate());
+		Assert.assertNull(step.getRoleArn());
+
+		step.setPollInterval(5000L);
+		step.setCreate(false);
+		step.setRoleArn("arn:aws:iam::123456789012:role/S3Access");
+
+		Assert.assertEquals(Long.valueOf(5000L), step.getPollInterval());
+		Assert.assertEquals(Boolean.FALSE, step.getCreate());
+		Assert.assertEquals("arn:aws:iam::123456789012:role/S3Access", step.getRoleArn());
+	}
